# =============================================================================
# iCLAN Entrepreneur Challenge - variables d'environnement
# Copiez ce fichier en .env.local puis completez les valeurs.
# =============================================================================

# --- Adresse publique de l'application ---------------------------------------
# Utilisee pour generer le QR code affiche sur l'ecran de la salle.
# En local sur un reseau wifi, indiquez l'adresse IP de la machine
# (ex : http://192.168.1.24:3000) pour que les telephones puissent y acceder.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (obligatoire) --------------------------------------------------
# Ces deux variables sont indispensables : sans elles, l'application refuse de
# servir les parties et affiche les variables manquantes. Il n'y a volontairement
# aucun mode de repli, un repli silencieux ferait perdre les scores.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cle de service : elle contourne les politiques RLS et donne acces aux bonnes
# reponses. Elle ne doit JAMAIS etre prefixee NEXT_PUBLIC_ ni exposee au client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Espace organisateur -----------------------------------------------------
ADMIN_PASSWORD=iclan2026

# --- Parametres de jeu -------------------------------------------------------
# Valeur initiale du nombre de questions servies par partie (10 par defaut).
# Une fois l'application lancee, l'organisateur regle ce nombre categorie par
# categorie depuis /admin, sans plafond autre que la taille de la banque : cette
# variable ne sert qu'au premier demarrage, avant tout reglage.
QUESTIONS_PER_SESSION=10
